{
  "name": "@kd/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "cli": "node dist/cli.js",
    "migrate": "node dist/cli.js migrate",
    "openapi:generate": "node dist/openapi/generate.js --out ../../packages/contracts/openapi.json",
    "openapi:check": "node dist/openapi/generate.js --check ../../packages/contracts/openapi.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "test:int": "vitest run --config vitest.int.config.ts --maxWorkers=1 --no-file-parallelism"
  },
  "devDependencies": {
    "@kd/eslint-config": "workspace:*",
    "@kd/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@kd/contracts": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.15",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "otpauth": "9.6.0",
    "pg": "catalog:",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "catalog:",
    "typeorm": "1.1.2"
  }
}
