{
  "name": "@kd/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=2 --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.16",
    "@kd/design-tokens": "workspace:*",
    "@kd/i18n": "workspace:*",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@kd/eslint-config": "workspace:*",
    "@kd/tsconfig": "workspace:*",
    "@react-native/jest-preset": "0.88.1",
    "@types/react": "19.3.0",
    "eslint": "catalog:",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*))"
    ]
  }
}
