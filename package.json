{
  "name": "kitchen-daylight",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "bootstrap": "scripts/bootstrap.sh",
    "env:sync": "scripts/env-sync.sh",
    "dev:infra": "scripts/dev-infra.sh up",
    "dev:infra:down": "scripts/dev-infra.sh down",
    "dev:infra:status": "scripts/dev-infra.sh status",
    "dev:api": "pnpm --filter @kd/api start:dev",
    "dev:admin": "pnpm --filter @kd/admin start",
    "dev:mobile": "pnpm --filter @kd/mobile start",
    "build": "turbo run build --concurrency=2",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "format:check": "turbo run format:check format:check:root --concurrency=2",
    "openapi:generate": "turbo run @kd/api#openapi:generate --concurrency=2 && turbo run @kd/contracts#client:generate --concurrency=2",
    "openapi:check": "turbo run @kd/api#openapi:check @kd/contracts#client:check --concurrency=2 && pnpm openapi:breaking",
    "openapi:breaking": "scripts/openapi-breaking.sh",
    "format:check:root": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern package.json turbo.json pnpm-workspace.yaml \"*.md\" \".github/**\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/config-pnpm-scopes": "21.2.2",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
