# Root .env of the monorepo, read only by processes run on the host
# (apps/api, tools/seed). apps/admin and apps/mobile never read it.
#
# Do not copy this file by hand: `pnpm env:sync` writes .env (mode 600) from
# the Docker repository's scripts/print-env.sh plus the monorepo block.
# Every value below is a placeholder. Names and rules:
# docs/decisions/0005-api-foundation-conventions.md, section 2.
# Commented-out names are not read by any code yet; they arrive with the
# slice that uses them.

# --- Runtime ---------------------------------------------------------------
# Required: dev | test | demo | prod. From print-env.sh.
APP_ENV=dev
# API port on the host (the container uses 3000). Monorepo block.
PORT=3001
# pino level, default info. Monorepo block.
LOG_LEVEL=info
# Express trust proxy hops: 0 or 1 (decision 0007, section 5). The host
# process has no proxy in front, so leave it unset (default 0); the Docker
# apps profile sets 1 (Caddy). Required (1) in demo and prod.
# TRUST_PROXY_HOPS=0

# --- Database (from print-env.sh) -------------------------------------------
# Host server connects as kd_app, host CLI as kd_migrator. env:sync writes
# the real URLs with the local password; this file holds none.
DATABASE_URL_APP=postgres://kd_app@127.0.0.1:5452/kd_dev
DATABASE_URL_MIGRATOR=postgres://kd_migrator@127.0.0.1:5452/kd_dev
# API integration tests only (pnpm --filter @kd/api test:int), never read by
# the server or the CLI. Replaces the database name of the two URLs above;
# default kd_scratch (empty, created by the Docker baseline). Must start with
# kd_, contain scratch or test, and differ from the dev database.
# TEST_DATABASE_NAME=kd_scratch
# Containers only. Never set on the host: with the two names above it is
# ambiguous and the process refuses to start.
# DATABASE_URL=

# --- Mail (from print-env.sh) -----------------------------------------------
# Mailpit SMTP address. Required when the mail adapter is smtp; port 1-65535.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1045
# Mailpit web UI, for people and e2e tests. Never read by the API.
MAIL_UI_URL=http://127.0.0.1:8045
# smtp | ses. dev/test default smtp, so leave it unset here; demo/prod
# required (ses). The ses adapter arrives in A12-T4; until then the mail
# factory refuses it, but only once a module that sends mail imports the
# mail module (A2-T2), so a server with ses boots without mail before that.
# MAIL_ADAPTER=smtp
# Sender address. dev/test default below; demo/prod required.
# MAIL_FROM=no-reply@kitchendaylight.example

# --- Storage (from print-env.sh) --------------------------------------------
# Endpoint override and static keys: local emulator only, unset in prod.
STORAGE_S3_ENDPOINT=http://127.0.0.1:9020
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY=CHANGE_ME_LOCAL
STORAGE_S3_SECRET_KEY=CHANGE_ME_LOCAL
STORAGE_S3_BUCKET_MEDIA=kd-dev-media
STORAGE_S3_BUCKET_PRIVATE=kd-dev-private
# Media slice. dev/test defaults s3 and us-east-1; demo/prod required.
# STORAGE_ADAPTER=s3
# STORAGE_S3_REGION=us-east-1

# --- Geocoding --------------------------------------------------------------
# Geo slice. dev/test default fixture; demo/prod required.
# GEOCODE_ADAPTER=fixture

# --- Auth (decision 0008, section 12) ---------------------------------------
# Required by the server. env:sync writes dev-only values into the monorepo
# block with node:crypto (never by hand, never printed): the base64 of a
# PKCS#8 and an SPKI PEM on P-256, a kid "kd-dev-" + 16 hex digits of the
# SHA-256 of the public key, and 32 random bytes in base64 for each secret.
# The placeholder below is not valid: run `pnpm env:sync`.
JWT_PRIVATE_KEY=generated-by-env-sync
JWT_PUBLIC_KEY=generated-by-env-sync
JWT_KEY_ID=generated-by-env-sync
OTP_HMAC_SECRET=generated-by-env-sync
MFA_ENCRYPTION_KEY=generated-by-env-sync
# Optional, key rotation only (never generated). Previous JWT public keys
# accepted for verification: <kid>:<base64 SPKI PEM>, comma-separated.
# JWT_PREVIOUS_PUBLIC_KEYS=
# Previous MFA encryption keys, decrypt only: base64, comma-separated.
# MFA_ENCRYPTION_PREVIOUS_KEYS=
# Social sign-in (A2-T6; decision 0008, section 11): the aud allow-lists,
# comma-separated client ids. Optional in every tier and not secrets, so
# env:sync never writes them; a provider left unset answers 404 NOT_FOUND
# on its routes. Google: the iOS, Android and web client ids; Apple: the
# bundle ids (later a Services ID). Placeholders below; set real ids only
# in the environment of the tier, never in a committed file.
# GOOGLE_CLIENT_IDS=0000-example.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.example.kitchendaylight
# Admin web origins (A3-T1; decision 0008, section 10): the exact Origin
# values allowed on POST /admin/auth/*, comma-separated, scheme://host[:port]
# with no path and no wildcard. Not a secret, so env:sync never writes it.
# dev/test default http://localhost:4200 (ng serve) when unset; add the Caddy
# origin of the Docker apps profile here if you use it. demo/prod required,
# https only. The first entry is the base of staff links.
# ADMIN_ORIGINS=http://localhost:4200

# --- Mobile store pages (A4-T3) ----------------------------------------------
# The storeUrl of the 400 UPGRADE_REQUIRED answer, per platform: an https URL.
# Optional in every tier and not secrets; unset means storeUrl null. The real
# store pages are set in the environment of the tier, never committed.
# APP_STORE_URL_IOS=https://apps.apple.invalid/app/kitchen-daylight
# APP_STORE_URL_ANDROID=https://play.google.invalid/store/apps/details?id=com.example.kitchendaylight
