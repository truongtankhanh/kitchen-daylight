# Root .env of the monorepo, read only by processes run on the host
# (apps/api, tools/seed). apps/admin and apps/mobile never read it.
#
# Do not copy this file by hand: `pnpm env:sync` writes .env (mode 600) from
# the Docker repository's scripts/print-env.sh plus the monorepo block.
# Every value below is a placeholder. Names and rules:
# docs/decisions/0005-api-foundation-conventions.md, section 2.
# Commented-out names are not read by any code yet; they arrive with the
# slice that uses them.

# --- Runtime ---------------------------------------------------------------
# Required: dev | test | demo | prod. From print-env.sh.
APP_ENV=dev
# API port on the host (the container uses 3000). Monorepo block.
PORT=3001
# pino level, default info. Monorepo block.
LOG_LEVEL=info

# --- Database (from print-env.sh) -------------------------------------------
# Host server connects as kd_app, host CLI as kd_migrator. env:sync writes
# the real URLs with the local password; this file holds none.
DATABASE_URL_APP=postgres://kd_app@127.0.0.1:5452/kd_dev
DATABASE_URL_MIGRATOR=postgres://kd_migrator@127.0.0.1:5452/kd_dev
# Containers only. Never set on the host: with the two names above it is
# ambiguous and the process refuses to start.
# DATABASE_URL=

# --- Mail (from print-env.sh) -----------------------------------------------
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1045
# Mailpit web UI, for people and e2e tests. Never read by the API.
MAIL_UI_URL=http://127.0.0.1:8045
# Mail slice. dev/test default smtp; demo/prod required (ses).
# MAIL_ADAPTER=smtp

# --- Storage (from print-env.sh) --------------------------------------------
# Endpoint override and static keys: local emulator only, unset in prod.
STORAGE_S3_ENDPOINT=http://127.0.0.1:9020
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ACCESS_KEY=CHANGE_ME_LOCAL
STORAGE_S3_SECRET_KEY=CHANGE_ME_LOCAL
STORAGE_S3_BUCKET_MEDIA=kd-dev-media
STORAGE_S3_BUCKET_PRIVATE=kd-dev-private
# Media slice. dev/test defaults s3 and us-east-1; demo/prod required.
# STORAGE_ADAPTER=s3
# STORAGE_S3_REGION=us-east-1

# --- Geocoding --------------------------------------------------------------
# Geo slice. dev/test default fixture; demo/prod required.
# GEOCODE_ADAPTER=fixture

# --- Auth -------------------------------------------------------------------
# Auth slice. Dev-only values are generated by env:sync in the monorepo
# block, never written by hand.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_KEY_ID=
# OTP_HMAC_SECRET=
