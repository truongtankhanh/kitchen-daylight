{
  "components": {
    "schemas": {
      "AuthSession": {
        "properties": {
          "accessToken": {
            "description": "ES256 JWT for `Authorization: Bearer`.",
            "type": "string"
          },
          "expiresIn": {
            "description": "Seconds until the access token expires.",
            "minimum": 0,
            "type": "integer"
          },
          "refreshToken": {
            "description": "Opaque, single use; kept in the device's secure store.",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "expiresIn",
          "accessToken",
          "refreshToken",
          "user"
        ],
        "type": "object"
      },
      "AuthUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "emailVerifiedAt": {
            "description": "`null` until the email is verified; ordering needs it, signing in does not.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerifiedAt",
          "displayName"
        ],
        "type": "object"
      },
      "ConsentAction": {
        "enum": [
          "GRANTED",
          "WITHDRAWN"
        ],
        "type": "string"
      },
      "ConsentDocumentType": {
        "enum": [
          "TERMS_OF_SERVICE",
          "PRIVACY_POLICY"
        ],
        "type": "string"
      },
      "ErrorCode": {
        "description": "Stable code of the catalogue (decision 0007 section 9).",
        "enum": [
          "VALIDATION_FAILED",
          "CODE_INVALID",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "INVALID_CREDENTIALS",
          "FORBIDDEN",
          "EMAIL_NOT_VERIFIED",
          "ACCOUNT_SUSPENDED",
          "NOT_FOUND",
          "STALE_VERSION",
          "ALREADY_EXISTS",
          "IN_USE",
          "UPGRADE_REQUIRED",
          "RATE_LIMITED",
          "MAINTENANCE",
          "LAST_ADMIN",
          "SELF_CHANGE",
          "REVIEW_EXISTS",
          "BRANCH_CLOSED",
          "ITEM_UNAVAILABLE",
          "PRICE_CHANGED",
          "OPTION_INVALID",
          "OUT_OF_ZONE",
          "BELOW_MIN_ORDER",
          "PHONE_REQUIRED",
          "VOUCHER_INVALID",
          "INSUFFICIENT_POINTS",
          "INVALID_TRANSITION",
          "ORDER_NOT_CANCELLABLE",
          "PAYMENT_NOT_CONFIRMED",
          "ORDER_NOT_REVIEWABLE",
          "SLOT_UNAVAILABLE",
          "HAS_ACTIVE_ORDERS",
          "MFA_REQUIRED",
          "ORDER_NOT_EDITABLE",
          "INVALID_STATE",
          "MFA_NOT_ENABLED",
          "REVIEW_NOT_PUBLISHED",
          "DUPLICATE_REPORT",
          "IDEMPOTENCY_CONFLICT",
          "DUPLICATE_RESERVATION",
          "TOO_LARGE",
          "UNSUPPORTED_TYPE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "ForgotPasswordDto": {
        "properties": {
          "email": {
            "description": "Trimmed before validation, as at registration.",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "type": "object"
      },
      "HealthReport": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "error",
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "deviceLabel": {
            "description": "Shown in the session list; display only. Defaults to `X-Client`.",
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "password",
          "email"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "avatarUrl": {
            "description": "Read only: there is no avatar upload.",
            "nullable": true,
            "type": "string"
          },
          "displayName": {
            "description": "1 to 60 characters.",
            "type": "string"
          },
          "email": {
            "description": "Changed only through the email-code flow (A2-T2), never by `PATCH /me`.",
            "format": "email",
            "type": "string"
          },
          "emailVerifiedAt": {
            "description": "`null` until the email is verified.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "phone": {
            "description": "E.164 (`+84…`); `null` when unset, and the next order then answers `PHONE_REQUIRED`.",
            "example": "+84901234567",
            "nullable": true,
            "type": "string"
          },
          "preferredBranchId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerifiedAt",
          "phone",
          "avatarUrl",
          "preferredBranchId",
          "displayName"
        ],
        "type": "object"
      },
      "MePasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          },
          "newPassword": {
            "description": "The password policy of the account's role (customers 10 to 128 code points after NFC).",
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "MeUpdateDto": {
        "properties": {
          "displayName": {
            "description": "1 to 60 characters after trimming (`TOO_LONG`; mobile G95).",
            "maxLength": 60,
            "type": "string"
          },
          "phone": {
            "description": "A Vietnamese mobile number in national (`0…`) or international (`+84…`, `84…`) form, stored in\nE.164; anything else is `INVALID_PHONE` (mobile G97). `null` clears it (mobile G96).",
            "example": "0901234567",
            "nullable": true,
            "type": "string"
          },
          "preferredBranchId": {
            "description": "An existing, not deleted branch (`NOT_FOUND` otherwise), or `null` to clear.",
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "MyConsent": {
        "properties": {
          "action": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConsentAction"
              }
            ]
          },
          "documentId": {
            "format": "uuid",
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConsentDocumentType"
              }
            ]
          },
          "version": {
            "description": "The document version the event refers to.",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "type",
          "action",
          "occurredAt",
          "version",
          "locale"
        ],
        "type": "object"
      },
      "MySession": {
        "properties": {
          "createdAt": {
            "description": "When the device signed in.",
            "format": "date-time",
            "type": "string"
          },
          "deviceLabel": {
            "description": "The label the device sent at sign-in, or `unknown`; display only.",
            "type": "string"
          },
          "id": {
            "description": "The family id: the path parameter of `DELETE /me/sessions/{id}`.",
            "format": "uuid",
            "type": "string"
          },
          "isCurrent": {
            "description": "The session of the access token that made this request.",
            "type": "boolean"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdAt",
          "lastUsedAt",
          "deviceLabel",
          "isCurrent"
        ],
        "type": "object"
      },
      "MySessionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MySession"
            },
            "type": "array"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "Stable code of the catalogue (decision 0007 section 9)."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "Province": {
        "properties": {
          "code": {
            "description": "Official code, 2 digits, as text (for example `79`).",
            "example": "79",
            "type": "string"
          },
          "fullName": {
            "description": "`names.vi_full`: the official full name (for example `Thành phố Hồ Chí Minh`).",
            "type": "string"
          },
          "name": {
            "description": "`names.vi`: the short name without the type prefix (for example `Hồ Chí Minh`).",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProvinceType"
              }
            ]
          }
        },
        "required": [
          "code",
          "type",
          "name",
          "fullName"
        ],
        "type": "object"
      },
      "ProvinceType": {
        "enum": [
          "CITY",
          "PROVINCE"
        ],
        "type": "string"
      },
      "RefreshTokenDto": {
        "properties": {
          "refreshToken": {
            "description": "The opaque refresh token from the last sign-in or refresh.",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "acceptedDocumentIds": {
            "description": "Exactly the ids of the current Terms of Service and Privacy Policy (locale `vi`).",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "deviceLabel": {
            "description": "Shown in the session list; display only. Defaults to `X-Client`.",
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "displayName": {
            "description": "At most 60 characters, trimmed.",
            "maxLength": 60,
            "type": "string"
          },
          "email": {
            "description": "Trimmed and lower-cased before it is stored. Trimmed here, before validation, because\n`@IsEmail()` refuses surrounding whitespace that a keyboard or autofill may add.",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "description": "10 to 128 Unicode code points after NFC; not the email or its local part.",
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          },
          "phone": {
            "description": "Optional at registration. A Vietnamese mobile number, national (`0…`) or international (`+84…`,\n`84…`) form; stored in E.164.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "password",
          "email",
          "displayName",
          "acceptedDocumentIds"
        ],
        "type": "object"
      },
      "ResetPasswordDto": {
        "properties": {
          "code": {
            "description": "The 6-digit code from the mail; spaces are ignored.",
            "maxLength": 16,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "newPassword": {
            "description": "10 to 128 Unicode code points after NFC; not the email or its local part.",
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "newPassword",
          "email",
          "code"
        ],
        "type": "object"
      },
      "SendEmailCodeDto": {
        "properties": {
          "email": {
            "description": "Another address to verify instead of the account email (the \"another email\" path), only while\nthe account is unverified. Trimmed and lower-cased; absent sends the code to the account email.",
            "format": "email",
            "maxLength": 254,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerifyEmailDto": {
        "properties": {
          "code": {
            "description": "The 6-digit code from the mail; spaces are ignored.",
            "maxLength": 16,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "Ward": {
        "properties": {
          "code": {
            "description": "Official code, 5 digits, as text, unique across the country (for example `26743`).",
            "example": "26743",
            "type": "string"
          },
          "fullName": {
            "description": "`names.vi_full`: the official full name (for example `Phường Bến Thành`).",
            "type": "string"
          },
          "name": {
            "description": "`names.vi`: the short name without the type prefix (for example `Bến Thành`).",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WardType"
              }
            ]
          }
        },
        "required": [
          "code",
          "type",
          "name",
          "fullName"
        ],
        "type": "object"
      },
      "WardType": {
        "enum": [
          "WARD",
          "COMMUNE",
          "SPECIAL_ZONE"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "KD API",
    "version": "0.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": ""
          }
        },
        "security": [],
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/auth/email/send-code": {
      "post": {
        "operationId": "AuthCodesController_sendCode_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailCodeDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The same answer whether or not a message was sent."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "UNAUTHENTICATED, TOKEN_EXPIRED"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "FORBIDDEN"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "INVALID_STATE"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "AuthCodes"
        ]
      }
    },
    "/api/v1/auth/email/verify": {
      "post": {
        "operationId": "AuthCodesController_verifyEmail_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "VALIDATION_FAILED, CODE_INVALID"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "UNAUTHENTICATED, TOKEN_EXPIRED"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "FORBIDDEN"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "AuthCodes"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "INVALID_CREDENTIALS"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "ACCOUNT_SUSPENDED"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "security": [],
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "security": [],
        "summary": "Public, so a client whose access token expired can still sign out; unknown token → `204`.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll_v1",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "UNAUTHENTICATED, TOKEN_EXPIRED"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "summary": "Signs the caller out of every device: every refresh-token family of the token's user.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "operationId": "AuthCodesController_forgotPassword_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The same answer whether or not the email has an account."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
