{
  "components": {
    "schemas": {
      "AuthSession": {
        "properties": {
          "accessToken": {
            "description": "ES256 JWT for `Authorization: Bearer`.",
            "type": "string"
          },
          "expiresIn": {
            "description": "Seconds until the access token expires.",
            "minimum": 0,
            "type": "integer"
          },
          "refreshToken": {
            "description": "Opaque, single use; kept in the device's secure store.",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "expiresIn",
          "accessToken",
          "refreshToken",
          "user"
        ],
        "type": "object"
      },
      "AuthUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "emailVerifiedAt": {
            "description": "`null` until the email is verified; ordering needs it, signing in does not.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerifiedAt",
          "displayName"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable code of the catalogue (decision 0007 section 9).",
        "enum": [
          "VALIDATION_FAILED",
          "CODE_INVALID",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "INVALID_CREDENTIALS",
          "FORBIDDEN",
          "EMAIL_NOT_VERIFIED",
          "ACCOUNT_SUSPENDED",
          "NOT_FOUND",
          "STALE_VERSION",
          "ALREADY_EXISTS",
          "IN_USE",
          "UPGRADE_REQUIRED",
          "RATE_LIMITED",
          "MAINTENANCE",
          "LAST_ADMIN",
          "SELF_CHANGE",
          "REVIEW_EXISTS",
          "BRANCH_CLOSED",
          "ITEM_UNAVAILABLE",
          "PRICE_CHANGED",
          "OPTION_INVALID",
          "OUT_OF_ZONE",
          "BELOW_MIN_ORDER",
          "PHONE_REQUIRED",
          "VOUCHER_INVALID",
          "INSUFFICIENT_POINTS",
          "INVALID_TRANSITION",
          "ORDER_NOT_CANCELLABLE",
          "PAYMENT_NOT_CONFIRMED",
          "ORDER_NOT_REVIEWABLE",
          "SLOT_UNAVAILABLE",
          "HAS_ACTIVE_ORDERS",
          "MFA_REQUIRED",
          "ORDER_NOT_EDITABLE",
          "INVALID_STATE",
          "MFA_NOT_ENABLED",
          "REVIEW_NOT_PUBLISHED",
          "DUPLICATE_REPORT",
          "IDEMPOTENCY_CONFLICT",
          "DUPLICATE_RESERVATION",
          "TOO_LARGE",
          "UNSUPPORTED_TYPE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "ForgotPasswordDto": {
        "properties": {
          "email": {
            "description": "Trimmed before validation, as at registration.",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "type": "object"
      },
      "HealthReport": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "error",
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "deviceLabel": {
            "description": "Shown in the session list; display only. Defaults to `X-Client`.",
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "password",
          "email"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "Stable code of the catalogue (decision 0007 section 9)."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "RefreshTokenDto": {
        "properties": {
          "refreshToken": {
            "description": "The opaque refresh token from the last sign-in or refresh.",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "acceptedDocumentIds": {
            "description": "Exactly the ids of the current Terms of Service and Privacy Policy (locale `vi`).",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "deviceLabel": {
            "description": "Shown in the session list; display only. Defaults to `X-Client`.",
            "maxLength": 80,
            "nullable": true,
            "type": "string"
          },
          "displayName": {
            "description": "At most 60 characters, trimmed.",
            "maxLength": 60,
            "type": "string"
          },
          "email": {
            "description": "Trimmed and lower-cased before it is stored. Trimmed here, before validation, because\n`@IsEmail()` refuses surrounding whitespace that a keyboard or autofill may add.",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "description": "10 to 128 Unicode code points after NFC; not the email or its local part.",
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          },
          "phone": {
            "description": "Optional at registration. A Vietnamese mobile number, national (`0…`) or international (`+84…`,\n`84…`) form; stored in E.164.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "password",
          "email",
          "displayName",
          "acceptedDocumentIds"
        ],
        "type": "object"
      },
      "ResetPasswordDto": {
        "properties": {
          "code": {
            "description": "The 6-digit code from the mail; spaces are ignored.",
            "maxLength": 16,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "newPassword": {
            "description": "10 to 128 Unicode code points after NFC; not the email or its local part.",
            "format": "password",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "newPassword",
          "email",
          "code"
        ],
        "type": "object"
      },
      "SendEmailCodeDto": {
        "properties": {
          "email": {
            "description": "Another address to verify instead of the account email (the \"another email\" path), only while\nthe account is unverified. Trimmed and lower-cased; absent sends the code to the account email.",
            "format": "email",
            "maxLength": 254,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerifyEmailDto": {
        "properties": {
          "code": {
            "description": "The 6-digit code from the mail; spaces are ignored.",
            "maxLength": 16,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "KD API",
    "version": "0.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": ""
          }
        },
        "security": [],
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/auth/email/send-code": {
      "post": {
        "operationId": "AuthCodesController_sendCode_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailCodeDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The same answer whether or not a message was sent."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "UNAUTHENTICATED, TOKEN_EXPIRED"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "FORBIDDEN"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "INVALID_STATE"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "AuthCodes"
        ]
      }
    },
