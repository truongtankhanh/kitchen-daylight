{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Stable code of the catalogue (decision 0007 section 9).",
        "enum": [
          "VALIDATION_FAILED",
          "CODE_INVALID",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "INVALID_CREDENTIALS",
          "FORBIDDEN",
          "EMAIL_NOT_VERIFIED",
          "ACCOUNT_SUSPENDED",
          "NOT_FOUND",
          "STALE_VERSION",
          "ALREADY_EXISTS",
          "IN_USE",
          "UPGRADE_REQUIRED",
          "RATE_LIMITED",
          "MAINTENANCE",
          "LAST_ADMIN",
          "SELF_CHANGE",
          "REVIEW_EXISTS",
          "BRANCH_CLOSED",
          "ITEM_UNAVAILABLE",
          "PRICE_CHANGED",
          "OPTION_INVALID",
          "OUT_OF_ZONE",
          "BELOW_MIN_ORDER",
          "PHONE_REQUIRED",
          "VOUCHER_INVALID",
          "INSUFFICIENT_POINTS",
          "INVALID_TRANSITION",
          "ORDER_NOT_CANCELLABLE",
          "PAYMENT_NOT_CONFIRMED",
          "ORDER_NOT_REVIEWABLE",
          "SLOT_UNAVAILABLE",
          "HAS_ACTIVE_ORDERS",
          "MFA_REQUIRED",
          "ORDER_NOT_EDITABLE",
          "INVALID_STATE",
          "MFA_NOT_ENABLED",
          "REVIEW_NOT_PUBLISHED",
          "DUPLICATE_REPORT",
          "IDEMPOTENCY_CONFLICT",
          "DUPLICATE_RESERVATION",
          "TOO_LARGE",
          "UNSUPPORTED_TYPE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "database"
        ],
        "type": "object"
      },
      "HealthReport": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "error",
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "Stable code of the catalogue (decision 0007 section 9)."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "title",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "KD API",
    "version": "0.0.0"
  },
  "openapi": "3.0.0",
