{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "kd library (compiled ESM packages)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "outDir": "${configDir}/dist"
  }
}
