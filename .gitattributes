# Normalise line endings for every text file
* text=auto

# Force LF where tooling or containers break on CRLF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf

# Lockfile: generated, hidden from diffs and language stats
pnpm-lock.yaml -diff linguist-generated

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
